# Copy to Vercel → Settings → Environment Variables. NEVER commit real values.

# ── Supabase (a NEW project, only for the IT Help Desk) ──────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Zoho sign-in (a NEW Zoho API client, only for the IT Help Desk) ──
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
# Use https://accounts.zoho.eu (or .in, .com.au …) if your Zoho account is in another region
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# ── This app's public address (no trailing slash) ────────────
APP_URL=https://it-helpdesk.vercel.app

# ── Sending email (a dedicated mailbox, e.g. it-helpdesk@your-company.com) ──
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=it-helpdesk@your-company.com
SMTP_PASS=your-app-password
MAIL_FROM_NAME=IT Help Desk
# Optional: show a shared/group address as the sender. SMTP_USER must be allowed to "Send as" it in Zoho.
MAIL_FROM_ADDRESS=

# ── Help desk rules ──────────────────────────────────────────
# Optional shared support inbox that gets copies of new tickets. Leave EMPTY for none:
# then nothing is sent to any "support" address, and unassigned tickets go to the IT manager.
IT_SUPPORT_EMAIL=
# These people become admins the first time they sign in (comma-separated).
BOOTSTRAP_ADMIN_EMAILS=admin@your-company.com
# Anyone with an email on these domains can sign in and raise tickets (comma-separated).
# Leave empty to allow only people an admin has added.
ALLOWED_EMAIL_DOMAINS=your-company.com
